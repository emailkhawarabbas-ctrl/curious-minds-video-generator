# Copy to .env and fill in what you have. Everything is optional:
# without keys the system uses curated content packs / offline templates,
# keyless research APIs (Wikipedia, MedlinePlus, PubMed) and local Piper TTS.

# Anthropic API key for script / storyboard / metadata generation (Claude).
LLM_API_KEY=

# Optional: Tavily web-search key (searches restricted to authoritative domains).
RESEARCH_API_KEY=

# Only needed if you add a paid TTS provider (Piper is free and local).
TTS_API_KEY=

# Optional config overrides, format CM__SECTION__KEY=value, e.g.
# CM__TTS__VOICE=en_US-norman-medium
# CM__RENDER__WORKERS=4
